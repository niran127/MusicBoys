<%- include("partials/head") %> <%- include("partials/aside") %>
<div id="page-home">
            <div class="topbar">
               <h1 class="greeting" id="greeting">
                  Goedemorgen, <span>gebruiker</span>
               </h1>
               <div class="user-pill">
                  <div class="avatar" id="user-avatar">U</div>
                  <span class="user-name" id="user-name">Mijn account</span>
                  <svg
                     width="14"
                     height="14"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     >
                     <polyline points="6 9 12 15 18 9" />
                  </svg>
               </div>
            </div>
            <!-- mood -->
            <section>
               <div class="section-title">Kies je mood</div>
               <form class="moods" action="http://localhost:1234/musicMatch" method="POST">
                  <button class="mood-chip <%= mood === "chill"? "selected":"" %>" data-mood="Chill" type="submit" name="mood" value="chill">
                     <svg
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        >
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                     </svg>
                     Chill
                  </button>
                  <button class="mood-chip <%= mood === "focus"? "selected":"" %>" data-mood="Focus" value="focus" name="mood" type="submit" >
                     <svg
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        >
                        <circle cx="12" cy="12" r="10" />
                        <circle cx="12" cy="12" r="3" />
                     </svg>
                     Focus
                  </button>
                  <button class="mood-chip <%= mood === "party"? "selected":"" %>" data-mood="Party" value="party" name="mood" type="submit">
                     <svg
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        >
                        <polygon
                           points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
                           />
                     </svg>
                     Party
                  </button>
                  <button class="mood-chip <%= mood === "sad" ? "selected":"" %>" data-mood="Sad" value="sad" name="mood" type="submit" ">
                     <svg
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        >
                        <circle cx="12" cy="12" r="10" />
                        <path d="M16 16s-1.5-2-4-2-4 2-4 2" />
                        <line x1="9" y1="9" x2="9.01" y2="9" />
                        <line x1="15" y1="9" x2="15.01" y2="9" />
                     </svg>
                     Sad
                  </button>
                  <button class="mood-chip <%= mood === "workout" ? "selected":"" %>" data-mood="Workout" value="workout" name="mood" type="submit">
                     <svg
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        >
                        <path d="M18 8h1a4 4 0 0 1 0 8h-1" />
                        <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z" />
                        <line x1="6" y1="1" x2="6" y2="4" />
                        <line x1="10" y1="1" x2="10" y2="4" />
                        <line x1="14" y1="1" x2="14" y2="4" />
                     </svg>
                     Workout
                  </button>
               </form>
            </section>
            <section>
               <div class="section-title">Snelle acties</div>
               <div class="actions-grid">
                  <div class="action-card" id="action-zoek">
                     <div class="action-icon">
                        <svg
                           width="20"
                           height="20"
                           viewBox="0 0 24 24"
                           fill="none"
                           stroke="#7c5cfc"
                           stroke-width="2"
                           stroke-linecap="round"
                           >
                           <circle cx="11" cy="11" r="8" />
                           <line x1="21" y1="21" x2="16.65" y2="16.65" />
                        </svg>
                     </div>
                     <div class="action-info">
                        <div class="action-title">Zoek muziek</div>
                        <div class="action-sub">Artiesten en nummers</div>
                     </div>
                     <svg
                        class="action-arrow"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        >
                        <polyline points="9 18 15 12 9 6" />
                     </svg>
                  </div>
                  <div class="action-card" id="action-likes">
                     <div class="action-icon">
                        <svg
                           width="20"
                           height="20"
                           viewBox="0 0 24 24"
                           fill="none"
                           stroke="#7c5cfc"
                           stroke-width="2"
                           stroke-linecap="round"
                           >
                           <path
                              d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"
                              />
                        </svg>
                     </div>
                     <div class="action-info">
                        <div class="action-title">Mijn collectie</div>
                        <div class="action-sub">Gelikete nummers</div>
                     </div>
                     <svg
                        class="action-arrow"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        >
                        <polyline points="9 18 15 12 9 6" />
                     </svg>
                  </div>
                  <div class="action-card">
                     <div class="action-icon">
                        <svg
                           width="20"
                           height="20"
                           viewBox="0 0 24 24"
                           fill="none"
                           stroke="#7c5cfc"
                           stroke-width="2"
                           stroke-linecap="round"
                           >
                           <line x1="8" y1="6" x2="21" y2="6" />
                           <line x1="8" y1="12" x2="21" y2="12" />
                           <line x1="8" y1="18" x2="21" y2="18" />
                           <line x1="3" y1="6" x2="3.01" y2="6" />
                           <line x1="3" y1="12" x2="3.01" y2="12" />
                           <line x1="3" y1="18" x2="3.01" y2="18" />
                        </svg>
                     </div>
                     <div class="action-info">
                        <div class="action-title">Genereer playlist</div>
                        <div class="action-sub">Op basis van je mood</div>
                     </div>
                     <svg
                        class="action-arrow"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        >
                        <polyline points="9 18 15 12 9 6" />
                     </svg>
                  </div>
               </div>
            </section>
         </div>
<%- include("partials/footer") %>