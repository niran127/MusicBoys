<%- include("partials/head") %> <%- include("partials/aside") %>
<div id="page-zoeken">
            <div class="topbar">
               <h1 class="greeting">Zoeken</h1>
            </div>
            <section>
               <div class="search-bar">
                  <div class="search-input-wrap">
                     <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        >
                        <circle cx="11" cy="11" r="8" />
                        <line x1="21" y1="21" x2="16.65" y2="16.65" />
                     </svg>
                     <form action="/musicMatch/search" method="post">
                     <input
                        id="zoekVeld"
                        name="zoekVeld"
                        type="text"
                        placeholder="Zoek naar artiesten of nummers ..."
                        style="background-color: var(--card)"
                        autocomplete="off"
                        />
                     <button id="zoekKnop" class="search-btn">Zoeken</button>
                     </form>
                  </div>
                  
               </div>
               <form class="filter-chips" action="http://localhost:1234/musicMatch/search/setting" method="POST">
                  <button class="filter-chip <%= set === "track,artist" ? "selected":"" %>" id="alles" name="set" type="submit" value="track,artist">Alles</button>
                  <button class="filter-chip <%= set === "artist" ? "selected":"" %>" id="artiesten" name="set" type="submit" value="artist">Artiesten</button>
                  <button class="filter-chip <%= set === "track" ? "selected":"" %>" id="nummer" name="set" type="submit" value="track">Nummers</button>
               </form>
            </section>
            <section>
               <div class="section-title">Resultaten</div>
               <div class="tracks" id="resultaten">
                  <% if (typeof results !== 'undefined' && results.length > 0) { %>
                     <%for(item of results){%>
                        <%if(item.type === "track"){%>
                           <div class="track-row playable" 
                              data-uri="<%= item.uri %>" 
                              data-name="<%= item.name %>">
                              
                              <div class="track-art-container">
                                 <img class="track-art" src="<%= item.img.url %>" alt="<%= item.name %>">                                 
                                 <div class="track-art-placeholder">:(</div>
                                       <div class="play-overlay">
                                          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                                             <polygon points="5 3 19 12 5 21 5 3"></polygon>
                                          </svg>
                                       </div>
                              </div>

                              <div class="track-info">
                                 <div class="track-name">
                                       <span class="track-title-link"><%= item.name %></span>
                                 </div>
                                 <div class="track-artist">
                                       <span class="track-artist-link">
                                          <%=item.artistsStr%>
                                       </span>
                                 </div>
                              </div>

                              <span class="track-type-badge">
                                 Nummer
                              </span>

                              <form class="track-actions">
                                 <button class="track-add-btn" title="Toevoegen">
                                       <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                          <line x1="12" y1="5" x2="12" y2="19"></line>
                                          <line x1="5" y1="12" x2="19" y2="12"></line>
                                       </svg>
                                 </button>
                                 <button class="track-like-btn" title="Like">
                                       <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                                       </svg>
                                 </button>
                              </form>
                           </div>
                        <%}else{%>
                           <div class="track-row" 
                              data-uri="<%= item.uri %>" 
                              data-name="<%= item.name %>">
                           <div class="track-art-container">
                                 <% if (item.img) { %>
                                    <img class="track-art" src="<%= item.img.url %>" alt="<%= item.name %>" style="border-radius: 50%;">
                                 <% } else { %>
                                    <div class="track-art-placeholder" style="border-radius: 50%;">:(</div>
                                 <% } %>
                           </div>

                           <div class="track-info">
                                 <div class="track-name">
                                    <span class="track-title-link"><%= item.name %></span>
                                 </div>
                                 <div class="track-artist">
                                    <span class="track-artist-link">Artiest</span>
                                 </div>
                           </div>

                           <span class="track-type-badge">
                                 Artiest
                           </span>

                           <div class="track-actions">
                                 <button class="track-like-btn" title="Volgen">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                       <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                                    </svg>
                                 </button>
                           </div>
                        </div>
                        <%}%>
                     <%}%>
                  <% } else if (typeof results !== 'undefined') { %>
                     <p class="no-results">Geen resultaten gevonden.</p>
                  <% } %>
               </div>
            </section>
         </div>
<%- include("partials/footer") %>