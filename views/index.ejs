<!doctype html>
<html lang="nl">
   <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <link rel="stylesheet" href="/styles/reset.css" />
      <link rel="stylesheet" href="/styles/variables.css" />
      <link rel="stylesheet" href="/styles/layout.css" />
      <link rel="stylesheet" href="/styles/sidebar.css" />
      <link rel="stylesheet" href="/styles/player.css" />
      <link rel="stylesheet" href="/styles/home-page.css" />
      <link rel="stylesheet" href="/styles/search-page.css" />
      <link rel="stylesheet" href="/styles/tracks.css" />
      <link rel="stylesheet" href="/styles/playlist-page.css" />
      <link rel="stylesheet" href="/styles/detail-page.css" />
      <link rel="stylesheet" href="/styles/game.css" />
      <link rel="stylesheet" href="/styles/modals.css" />
      <link rel="stylesheet" href="/styles/mobile.css" />
      <script>
         window._spSDKFired = false;
         window.SP_CLIENT_ID = "<%= spClientId %>";
         window.REDIRECT_URI = "<%= process.env.REDIRECT_URI || 'http://127.0.0.1:3050/app' %>";
         window.onSpotifyWebPlaybackSDKReady = function () {
         window._spSDKFired = true;
         if (window._initSpotifyPlayer) window._initSpotifyPlayer();
         };
      </script>
      <script src="/scripts/spotify.js" defer></script>
      <script src="/scripts/ui-utils.js" defer></script>
      <script src="/scripts/navigation.js" defer></script>
      <script src="/scripts/playlists.js" defer></script>
      <script src="/scripts/search.js" defer></script>
      <script src="/scripts/home.js" defer></script>
      <script src="/scripts/game.js" defer></script>
      <script src="https://sdk.scdn.co/spotify-player.js" async></script>
      <style>
         .dropdown-item { display: flex; align-items: center; gap: 12px; padding: 10px 12px; border-radius: 8px; color: var(--text); font-size: 0.85rem; transition: background 0.15s; cursor: pointer; }
         .dropdown-item:hover { background: rgba(255,255,255,0.05); }
         .light-theme .dropdown-item:hover { background: rgba(0,0,0,0.05); }
         .user-dropdown.active { display: block !important; }
         .follow-btn.followed { background: rgba(255,255,255,0.05) !important; color: var(--muted) !important; border: 1px solid var(--border) !important; cursor: default; }
      </style>
      <script>
         document.addEventListener('DOMContentLoaded', () => {
            const prefTheme = "<%= user.preferredTheme %>";
            if (prefTheme === 'light' && typeof setTheme === 'function') {
               setTheme('light');
            }
         });
      </script>
      <title>MusicMatch</title>
   </head>
   <body>
      <div class="mobile-header">
         <div class="mobile-header-mood" id="mobile-mood">Focus</div>
         <div class="mobile-header-logo">MusicBoys</div>
         <div class="mobile-header-user">
            <div class="avatar mobile-avatar" style="overflow: hidden;">
               <% if (user.profileImageUrl) { %>
                  <img src="<%= user.profileImageUrl %>" style="width: 100%; height: 100%; object-fit: cover;">
               <% } else { %>
                  <%= user.name.charAt(0).toUpperCase() %>
               <% } %>
            </div>
         </div>
      </div>
      <aside class="sidebar">
         <div class="logo">
            <span class="logo-text">MusicMatch</span>
         </div>
         <nav>
            <div class="nav-label">Menu</div>
            <div class="nav-item active" id="nav-home">
               <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" />
               </svg>
               <span class="nav-text">Home</span>
            </div>
            <div class="nav-item" id="nav-zoeken">
               <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  >
                  <circle cx="11" cy="11" r="8" />
                  <line x1="21" y1="21" x2="16.65" y2="16.65" />
               </svg>
               <span class="nav-text">Zoeken</span>
            </div>
            <div class="nav-item desktop-hidden" id="nav-collectie">
               <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  >
                  <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                  <path
                     d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"
                     />
               </svg>
               <span class="nav-text">Collectie</span>
            </div>
            <div class="nav-item" id="nav-game">
               <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  >
                  <polygon points="5 3 19 12 5 21 5 3" />
               </svg>
               <span class="nav-text">Game</span>
            </div>
            <div class="nav-label" style="margin-top: 20px">Playlists</div>
            <div class="nav-item" id="nav-new-playlist">
               <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  >
                  <line x1="12" y1="5" x2="12" y2="19" />
                  <line x1="5" y1="12" x2="19" y2="12" />
               </svg>
               Nieuwe playlist
            </div>
            <div class="nav-item" id="nav-likes">
               <svg
                  width="24"
                  height="24"
                  viewBox="0 0 48 48"
                  version="1"
                  enable-background="new 0 0 48 48"
                  >
                  <path
                     fill="#FFCDD2"
                     d="M34,9c-4.2,0-7.9,2.1-10,5.4C21.9,11.1,18.2,9,14,9C7.4,9,2,14.4,2,21c0,11.9,22,24,22,24s22-12,22-24C46,14.4,40.6,9,34,9z"
                     />
               </svg>
               Jouw likes
            </div>
            <div id="custom-playlists-list">
               <% playlists.forEach(playlist => { %>
                  <div class="nav-item playlist-item" data-id="<%= playlist._id %>">
                     <%= playlist.name %>
                  </div>
               <% }); %>
            </div>
      </aside>
      <main>
         <div class="global-header" style="display: flex; justify-content: flex-end; margin-bottom: 20px;">
            <div class="user-pill" id="user-pill" style="position: relative; cursor: pointer;">
               <div class="avatar" id="user-avatar" style="overflow: hidden;">
                  <% if (user.profileImageUrl) { %>
                     <img src="<%= user.profileImageUrl %>" style="width: 100%; height: 100%; object-fit: cover;">
                  <% } else { %>
                     <%= user.name.charAt(0).toUpperCase() %>
                  <% } %>
               </div>
               <span class="user-name" id="user-name"><%= user.name %></span>
               <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <polyline points="6 9 12 15 18 9" />
               </svg>
               <div class="user-dropdown" id="user-dropdown" style="display: none; position: absolute; top: 110%; right: 0; background: var(--card); border: 1px solid var(--border); border-radius: 12px; min-width: 180px; padding: 8px; z-index: 100; box-shadow: 0 10px 25px rgba(0,0,0,0.3); backdrop-filter: blur(10px);">
                  <div class="dropdown-item" id="change-photo-btn">
                     <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                     <span>Avatar aanpassen</span>
                  </div>
                  <div style="height: 1px; background: var(--border); margin: 8px 4px;"></div>
                  <div style="font-size: 0.7rem; font-weight: 700; color: var(--muted); padding: 4px 12px; text-transform: uppercase;">Thema</div>
                  <div class="dropdown-item theme-opt" data-theme="dark">
                     <div style="width: 10px; height: 10px; border-radius: 50%; background: #111; border: 1px solid white;"></div>
                     <span>Dark</span>
                  </div>
                  <div class="dropdown-item theme-opt" data-theme="light">
                     <div style="width: 10px; height: 10px; border-radius: 50%; background: #f5f5f5; border: 1px solid #333;"></div>
                     <span>Light</span>
                  </div>
                  <div style="height: 1px; background: var(--border); margin: 8px 4px;"></div>
                  <div class="dropdown-item" id="logout-btn">
                     <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                        <polyline points="16 17 21 12 16 7" />
                        <line x1="21" y1="12" x2="9" y2="12" />
                     </svg>
                     <span>Uitloggen</span>
                  </div>
                  <input type="file" id="profile-photo-input" style="display: none;" accept="image/*">
               </div>
            </div>
         </div>
         <div id="page-home">
            <div class="topbar" style="margin-top: -30px;">
                <div class="topbar-left">
                   <h1 class="greeting" id="greeting">
                      Goedemorgen, <span><%= user.name %></span>
                   </h1>
                   <div class="mood-badge" id="header-mood">
                      <span class="mood-dot"></span>
                      <span id="current-mood-text">Focus</span>
                   </div>
                </div>
            </div>
            <!-- mood -->
            <section>
               <div class="section-title">Kies je mood</div>
               <div class="moods">
                  <div class="mood-chip" data-mood="Chill">
                     <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                     </svg>
                     Chill
                  </div>
                  <div class="mood-chip" data-mood="Focus">
                     <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <circle cx="12" cy="12" r="10" />
                        <circle cx="12" cy="12" r="3" />
                     </svg>
                     Focus
                  </div>
                  <div class="mood-chip" data-mood="Party">
                     <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                     </svg>
                     Party
                  </div>
                  <div class="mood-chip" data-mood="Sad">
                     <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <circle cx="12" cy="12" r="10" />
                        <path d="M16 16s-1.5-2-4-2-4 2-4 2" />
                        <line x1="9" y1="9" x2="9.01" y2="9" />
                        <line x1="15" y1="9" x2="15.01" y2="9" />
                     </svg>
                     Sad
                  </div>
                  <div class="mood-chip" data-mood="Workout">
                     <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <path d="M18 8h1a4 4 0 0 1 0 8h-1" />
                        <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z" />
                        <line x1="6" y1="1" x2="6" y2="4" />
                        <line x1="10" y1="1" x2="10" y2="4" />
                        <line x1="14" y1="1" x2="14" y2="4" />
                     </svg>
                     Workout
                  </div>
               </div>
            </section>

            <!-- Playlist Generator Requirement -->
            <section style="margin-top: 48px;">
               <div class="generator-card" style="background: linear-gradient(135deg, var(--accent), var(--accent2)); padding: 40px; border-radius: 24px; color: white; position: relative; overflow: hidden;">
                  <div style="position: relative; z-index: 2;">
                    <h2 style="font-size: 1.8rem; font-weight: 800; margin-bottom: 8px;">Magic Mood Generator</h2>
                    <p style="opacity: 0.9; margin-bottom: 24px; max-width: 400px;">Genereer een unieke afspeellijst op basis van je huidige mood en favoriete nummers.</p>
                    <button id="generate-mood-playlist" class="btn" style="background: white; color: var(--accent); font-weight: 800; padding: 14px 32px; border-radius: 12px; border: none; cursor: pointer;">GENEREER NU</button>
                  </div>
                  <svg style="position: absolute; right: -20px; bottom: -20px; opacity: 0.2;" width="200" height="200" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/></svg>
               </div>
               <div id="generator-results" style="margin-top: 32px; display: none;">
                  <h3 class="section-title">Jouw Mood Mix</h3>
                  <div id="generator-list" class="tracks-list"></div>
               </div>
            </section>

            <section>
               <div class="section-title">Snelle acties</div>
               <div class="actions-grid">
                  <div class="action-card" id="action-zoek">
                     <div class="action-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#7c5cfc" stroke-width="2" stroke-linecap="round">
                           <circle cx="11" cy="11" r="8" />
                           <line x1="21" y1="21" x2="16.65" y2="16.65" />
                        </svg>
                     </div>
                     <div class="action-info">
                        <div class="action-title">Zoek muziek</div>
                        <div class="action-sub">Artiesten en nummers</div>
                     </div>
                     <svg class="action-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <polyline points="9 18 15 12 9 6" />
                     </svg>
                  </div>
                  <div class="action-card" id="action-likes">
                     <div class="action-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#7c5cfc" stroke-width="2" stroke-linecap="round">
                           <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                        </svg>
                     </div>
                     <div class="action-info">
                        <div class="action-title">Mijn collectie</div>
                        <div class="action-sub">Gelikete nummers</div>
                     </div>
                     <svg class="action-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <polyline points="9 18 15 12 9 6" />
                     </svg>
                  </div>
               </div>
            </section>
         </div>
         <div id="page-zoeken" style="display: none">
            <div class="topbar"><h1 class="greeting" style="margin-top: -30px;">Zoeken</h1></div>
            <section>
               <div class="search-bar">
                  <div class="search-input-wrap">
                     <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" />
                     </svg>
                     <input id="zoekVeld" type="text" placeholder="Zoek naar artiesten of nummers ..." style="background-color: var(--card)" autocomplete="off" />
                  </div>
                  <button id="zoekKnop" class="search-btn">Zoeken</button>
               </div>
               <div class="filter-chips">
                  <button class="filter-chip selected" id="alles">Alles</button>
                  <button class="filter-chip" id="artiesten">Artiesten</button>
                  <button class="filter-chip" id="nummer">Nummers</button>
               </div>
            </section>
            <section>
               <div class="section-title">Resultaten</div>
               <div class="tracks" id="resultaten"></div>
            </section>
         </div>
         
         <!-- Mobile Collectie Pagina -->
         <div id="page-collectie" style="display: none">
            <div class="collectie-header">
               <h1 class="page-title">Jouw Collectie</h1>
               <div class="collectie-tabs">
                  <div class="collectie-tab active" data-tab="playlists">Playlists</div>
                  <div class="collectie-tab" data-tab="likes">Likes</div>
               </div>
            </div>
            
            <div id="tab-content-playlists" class="tab-content">
               <div class="playlist-grid-mobile">
                  <!-- Plus button voor nieuwe playlist -->
                  <div class="playlist-card-mobile create-card" id="mobile-new-playlist">
                     <div class="card-art">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                     </div>
                     <div class="card-info">
                        <div class="card-name">Nieuwe playlist</div>
                     </div>
                  </div>
                  <!-- Playlists worden hier via JS gerenderd -->
                  <div id="mobile-playlists-list" class="playlist-grid-mobile" style="display: contents;"></div>
               </div>
            </div>
            
            <div id="tab-content-likes" class="tab-content" style="display: none">
               <div id="mobile-likes-list" class="tracks-list"></div>
            </div>
         </div>

         <div id="page-likes" style="display: none">
            <!--  likes content  -->
            <div class="likes-header">
               <div id="play-likes-btn" class="likes-cover-container">
                  <svg width="80" height="80" viewBox="0 0 24 24" fill="white"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" /></svg>
               </div>
                <div class="header-info">
                   <div class="playlist-label">Afspeellijst</div>
                   <h1 class="page-title">Jouw likes</h1>
                   <div class="likes-controls" style="margin-top: 15px; display: flex; gap: 10px;">
                      <input type="text" id="likes-artist-filter" placeholder="Filter op artiest of nummer..." autocomplete="off" style="background: var(--surface); color: var(--text); border: 1px solid var(--border); padding: 8px; border-radius: 8px; width: 100%; max-width: 400px;">
                   </div>
                </div>
            </div>
            <section><div id="likes-resultaten" class="tracks-list"></div></section>
         </div>

         <div id="page-playlist" style="display: none">
            <!--  playlist content  -->
            <div class="likes-header">
               <div id="play-playlist-btn" class="likes-cover-container" style="position: relative; overflow: hidden; cursor: pointer;" onclick="document.getElementById('playlist-cover-input').click()">
                  <img id="playlist-cover-img" src="" style="width: 100%; height: 100%; object-fit: cover; display: none;">
                  <div id="playlist-cover-placeholder" style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;">
                     <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="opacity: 0.3"><path d="M9 18V5l12-2v13"></path><circle cx="6" cy="18" r="3"></circle><circle cx="18" cy="16" r="3"></circle></svg>
                  </div>
                  <input type="file" id="playlist-cover-input" style="display: none;" accept="image/*">
               </div>
               <div style="flex-grow: 1">
                  <div class="playlist-label">Afspeellijst</div>
                  <div style="display: flex; align-items: baseline; justify-content: space-between;">
                     <h1 id="playlist-title" class="page-title">Naam</h1>
                     <button id="delete-playlist-btn">VERWIJDER PLAYLIST</button>
                  </div>
               </div>
            </div>
            <section><div id="playlist-resultaten" class="tracks-list"></div></section>
         </div>
         <div id="page-detail" style="display: none"></div>
         <div id="page-game" style="display: none; min-height: calc(100vh - 160px); padding: 40px 20px;">
            <!-- Content wordt dynamisch gegenereerd door game.js -->
            <div id="game-start-screen">
                <p style="color: var(--muted); margin-bottom: 30px;">Hoor een korte preview en raad de titel. Hoeveel heb jij er goed?</p>
                <button id="start-game-btn" class="btn btn-primary" style="width: 100%; padding: 16px; font-size: 1.1rem;">START SPEL</button>

              <div id="game-feedback" style="margin-top: 20px; font-weight: 600; display: none;"></div>
            </div>
         </div>
      </main>
      <footer>
         <!-- Player bar stays mostly the same but paths fixed -->
         <div class="player-info">
            <div class="now-art" id="now-art"></div>
            <div><div class="now-name" id="now-name"></div><div class="now-artist" id="now-artist"></div></div>
            <button class="like-btn" id="like-btn" title="Like">
               <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" /></svg>
            </button>
         </div>
         <div class="player-controls">
            <div class="ctrl-btns">
               <button class="ctrl-btn" title="Vorige"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><polygon points="19 20 9 12 19 4 19 20" /><line x1="5" y1="19" x2="5" y2="5" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></button>
               <button class="ctrl-btn play-btn" id="play-btn" title="Afspelen"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3" /></svg></button>
               <button class="ctrl-btn" title="Volgende"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 4 15 12 5 20 5 4" /><line x1="19" y1="5" x2="19" y2="19" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></button>
            </div>
            <div class="progress-row">
               <span class="progress-time" id="progress-current">0:00</span>
               <div class="progress-bar"><div class="progress-fill" id="progress-fill"></div></div>
               <span class="progress-time" id="progress-total">0:00</span>
            </div>
         </div>
         <div class="player-extra">
            <button class="ctrl-btn" title="Volume"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" /><path d="M19.07 4.93a10 10 0 0 1 0 14.14" /><path d="M15.54 8.46a5 5 0 0 1 0 7.07" /></svg></button>
            <div class="vol-row"><div class="vol-bar"><div class="vol-fill"></div></div></div>
            <button id="spotify-login-btn" class="spotify-login-btn">Login Spotify</button>
         </div>
      </footer>
      <!-- Playlist Modal -->
      <div id="playlist-modal" class="modal-overlay">
         <div class="modal-content">
            <h2 class="modal-title" id="playlist-modal-title">Nieuwe Playlist</h2>
            <p class="modal-message" id="playlist-modal-message">Geef een naam op voor je afspeellijst.</p>
            <input type="text" id="playlist-name-input" class="modal-input" placeholder="Naam..." autocomplete="off">
            <div class="modal-actions">
               <button id="playlist-modal-cancel" class="modal-btn modal-btn-cancel">ANNULEREN</button>
               <button id="playlist-modal-confirm" class="modal-btn modal-btn-confirm">AANMAKEN</button>
            </div>
         </div>
      </div>

      <!-- ── Playlist verwijderen: confirm modal ─────────────────────────────── -->
      <div id="confirm-delete-modal" class="modal-overlay">
         <div class="modal-content">
            <h2 class="modal-title">Playlist verwijderen</h2>
            <p class="modal-message">
               Weet je zeker dat je
               <strong id="confirm-delete-name"></strong>
               wilt verwijderen? Dit kan niet ongedaan worden gemaakt.
            </p>
            <div class="modal-actions">
               <button id="confirm-delete-cancel" class="modal-btn modal-btn-cancel">ANNULEREN</button>
               <button id="confirm-delete-ok"     class="modal-btn modal-btn-danger">VERWIJDEREN</button>
            </div>
         </div>
      </div>

      <!-- ── Cookie Consent Banner ─────────────────────────────────────────── -->
      <div id="cookie-banner" class="cookie-banner" role="dialog" aria-label="Cookie toestemming">
         <div class="cookie-inner">
            <div class="cookie-icon">🍪</div>
            <div class="cookie-text">
               <strong>Wij gebruiken cookies</strong>
               <p>Voor je sessie, stemming en voorkeuren. Geen advertenties, geen tracking van derden.</p>
            </div>
            <div class="cookie-actions">
               <button id="cookie-decline" class="cookie-btn cookie-btn-ghost">Weigeren</button>
               <button id="cookie-accept"  class="cookie-btn cookie-btn-solid">Accepteren</button>
            </div>
         </div>
      </div>

      <script>
        // Cookie consent – toont banner eenmalig
        (function () {
          const consent = localStorage.getItem('cookie_consent');
          const banner  = document.getElementById('cookie-banner');
          if (!consent && banner) banner.style.display = 'flex';
          document.getElementById('cookie-accept')?.addEventListener('click', () => {
            localStorage.setItem('cookie_consent', 'accepted');
            banner.style.display = 'none';
          });
          document.getElementById('cookie-decline')?.addEventListener('click', () => {
            localStorage.setItem('cookie_consent', 'declined');
            banner.style.display = 'none';
          });
        })();
      </script>
   </body>
</html>

