<%- include("partials/head") %> <%- include("partials/aside") %>
<div id="page-game" >
    <div class="game-container">
            <div class="game-header">
                <h1 class="game-title">Music Quiz</h1>
                <% if(start === false) {%>
                    <p class="game-score">Herken populaire hits in 10 seconden!</p>
                <%}else if(start === true) { %>
                    <div class="game-score">Score: <%= gameScore %> | Ronde: <%= gameRound %></div>
                <%}%>
            </div>
            <% if(start === false) {%>
                <div class="game-intro">
                    <p>Luister naar een fragment van een bekende hit en kies de juiste titel.<br>Je hebt 10 seconden de tijd per nummer.</p>
                    <form action="http://localhost:1234/musicMatch/game" method="POST">
                        <button class="start-btn" id="start-game-btn" name="start_knop" value=" ">START QUIZ</button>
                    </form>
                </div>
            <%}else if(start === true){ %>

            <script>
                window.gameConfig = {
                    previewUrl: "<%= currentTrack.preview_url %>"
                };
            </script>

            <script src="/scripts/game2.js"></script>
                <div class="audio-visualizer" id="visualizer">
                <div class="bar"></div><div class="bar"></div><div class="bar"></div>
                <div class="bar"></div><div class="bar"></div><div class="bar"></div>
                <div class="bar"></div><div class="bar"></div><div class="bar"></div>
                <div class="bar"></div><div class="bar"></div><div class="bar"></div>
            </div>

            <div class="game-player-controls">
                <button class="game-play-btn" id="game-toggle-btn">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                        <polygon points="5 3 19 12 5 21 5 3"></polygon>
                    </svg>
                </button>
                <div class="game-timer-container">
                    <div class="game-timer-fill" id="game-timer-fill"></div>
                </div>
            </div>

            <form class="options-grid" id="options-container" action="http://localhost:1234/musicMatch/game" method="POST">
                <button class="option-btn" name="answer" value="<%= opt[0].id %>"><span>1</span> <%=opt[0].name%> - <%=opt[0].artists[0].name%></button>
                <button class="option-btn" name="answer" value="<%= opt[1].id %>"><span>2</span> <%=opt[1].name%> - <%=opt[1].artists[0].name%></button>
                <button class="option-btn" name="answer" value="<%= opt[2].id %>"><span>3</span> <%=opt[2].name%> - <%=opt[2].artists[0].name%></button>
                <button class="option-btn" name="answer" value="<%= opt[3].id %>"><span>4</span> <%=opt[3].name%> - <%=opt[3].artists[0].name%></button>
            </form>

            <div class="game-status" id="game-status"></div>
            <button class="next-btn" id="next-round-btn">VOLGENDE RONDE</button>
        </div>
            <%}%>
        </div>
</div>
<%- include("partials/footer") %>