<%- include("partials/head") %> <%- include("partials/aside") %>
<div id="page-game" >
    <div class="game-container">
            <div class="game-header">
                <h1 class="game-title">Music Quiz</h1>
                <% if(start === false) {%>
                    <p class="game-score">Herken populaire hits in 10 seconden!</p>
                <%}else if(start === true) { %>
                    <div class="game-score">Score: <%= gameScore %> | Ronde: <%= gameRound %></div>
                <%}%>
            </div>
            <% if(start === false) {%>
                <div class="game-intro">
                    <p>Luister naar een fragment van een bekende hit en kies de juiste titel.<br>Je hebt 10 seconden de tijd per nummer.</p>
                    <form action="http://localhost:1234/musicMatch/game/start" method="POST">
                        <button class="start-btn" id="start-game-btn" name="start_knop" value=" ">START QUIZ</button>
                    </form>
                </div>
            <%}else if(start === true){ %>
            <% if(answer === false){ %>
                <script>
                    window.gameConfig = {
                        previewUrl: "<%= currentTrack.preview_url %>"
                    };
                </script>
                <script src="/scripts/game2.js"></script>
                <div class="audio-visualizer" id="visualizer">
                    <div class="bar"></div><div class="bar"></div><div class="bar"></div>
                    <div class="bar"></div><div class="bar"></div><div class="bar"></div>
                    <div class="bar"></div><div class="bar"></div><div class="bar"></div>
                    <div class="bar"></div><div class="bar"></div><div class="bar"></div>
                </div>

                <div class="game-player-controls">
                    <button class="game-play-btn" id="game-toggle-btn">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                            <polygon points="5 3 19 12 5 21 5 3"></polygon>
                        </svg>
                    </button>
                    <div class="game-timer-container">
                        <div class="game-timer-fill" id="game-timer-fill"></div>
                    </div>
                </div>
            <% } %>

            <form class="options-grid" id="options-container" action="http://localhost:1234/musicMatch/game/answer" method="POST">
                <% opt.forEach((option, index) => { 
                    let statusClass = "";
                    if (answer) {
                        if (option.id == currentTrack.id) {
                            statusClass = "correct";
                        } else if (option.id == userAnswer) {
                            statusClass = "wrong";
                        }
                    }
                %>
                    <button class="option-btn <%= statusClass %>" name="answer" value="<%= option.id %>" <%= answer ? 'disabled' : '' %>>
                        <span><%= index + 1 %></span> <%= option.name %> - <%= option.artists[0].name %>
                    </button>
                <% }) %>
            </form>

            <% if(answer === true){ %>
                <form action="/musicMatch/game/next" method="post">
                    <button class="next-btn" id="next-round-btn" name="next" value="a">VOLGENDE RONDE</button>
                </form>
            <% } %>
        </div>
            <%}%>
        </div>
</div>
<%- include("partials/footer") %>