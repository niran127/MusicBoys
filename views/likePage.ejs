<%- include("partials/head") %> <%- include("partials/aside") %>
<div id="page-likes">
            <div class="likes-header">
               <div id="play-likes-btn" class="likes-cover-container">
                  <svg width="80" height="80" viewBox="0 0 24 24" fill="white">
                     <path
                        d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"
                        />
                  </svg>
               </div>
               <div class="header-info">
                  <div class="playlist-label">Afspeellijst</div>
                  <h1 class="page-title">Jouw likes</h1>
               </div>
            </div>
            <section>
               <div id="likes-resultaten" class="tracks-list"></div>
               <%if(results){%>
               <%for(item of results){%>
               <%if(item.type === "track"){%>
                           <div class="track-row playable" 
                              data-uri="<%= item.uri %>" 
                              data-name="<%= item.name %>">
                              
                              <div class="track-art-container">
                                 <img class="track-art" src="<%= item.img.url %>" alt="<%= item.name %>">                                 
                                 <div class="track-art-placeholder">:(</div>
                                       <div class="play-overlay">
                                          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                                             <polygon points="5 3 19 12 5 21 5 3"></polygon>
                                          </svg>
                                       </div>
                              </div>

                              <div class="track-info">
                                 <div class="track-name">
                                       <span class="track-title-link"><%= item.name %></span>
                                 </div>
                                 <div class="track-artist">
                                       <span class="track-artist-link">
                                          <%=item.artistsStr%>
                                       </span>
                                 </div>
                              </div>

                              <span class="track-type-badge">
                                 Nummer
                              </span>

                              <form class="track-actions" action="http://localhost:1234/musicMatch/likePage/like" method="post">
                                 <button class="track-add-btn" title="Toevoegen">
                                       <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                          <line x1="12" y1="5" x2="12" y2="19"></line>
                                          <line x1="5" y1="12" x2="19" y2="12"></line>
                                       </svg>
                                 </button>
                                 <button class="track-like-btn <%= item.liked?"liked":"" %>" title="Like" name="likeId" value="<%=item.id%>">
                                       <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                                       </svg>
                                 </button>
                              </form>
                           </div>
                        <%}%>
                        <%}%>
                        <%}%>
            </section>
         </div>
<%- include("partials/footer") %>